# =============================================================================
# AI PLAGIARISM CHECKER - ROOT ENVIRONMENT
# Shared services configuration for local development
# For Vercel/Render/Railway: use platform environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# Shared Services (Redis + PostgreSQL + Qdrant)
# -----------------------------------------------------------------------------

# Redis Cloud (or local Redis for development)
# Render/Railway: Use provided REDIS_URL and parse components
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# PostgreSQL (metadata storage)
# Render/Railway: Use provided DATABASE_URL directly
DATABASE_URL=postgresql://postgres:password@localhost:5432/plagiarism_db

# JWT Secret (must be 32+ characters)
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-for-hmac-signing

# -----------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# Alternative: Pinecone (update ai-engine/.env.example if switching)
# -----------------------------------------------------------------------------

QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=document_embeddings

# Pinecone alternative (if not using Qdrant):
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-east-1
# PINECONE_INDEX_NAME=plagiarism-index

# -----------------------------------------------------------------------------
# Deployment Environment
# -----------------------------------------------------------------------------

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# File Storage
# Local development: ./uploads
# Production: Consider S3, GCS, or Render/Railway persistent disk
# -----------------------------------------------------------------------------

STORAGE_PATH=./uploads
