# =============================================================================
# AI ENGINE (Python / FastAPI + Celery on Render/Railway)
# Async document processing with NLP and vector embeddings
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Render/Railway automatically sets PORT; use 0.0.0.0 for container binding

# -----------------------------------------------------------------------------
# Redis / Celery Broker
# -----------------------------------------------------------------------------

# Local development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Render/Railway Redis Cloud:
# REDIS_HOST=redis-xxxxx.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-password
# REDIS_TLS=true

# Celery broker URLs (auto-constructed from REDIS_* if empty)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# -----------------------------------------------------------------------------
# Vector Database (Qdrant Cloud)
# -----------------------------------------------------------------------------

QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=document_embeddings

# Pinecone alternative (requires code change in vector_store.py):
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=us-east-1
# PINECONE_INDEX_NAME=plagiarism-index

# -----------------------------------------------------------------------------
# PostgreSQL (Results Storage)
# -----------------------------------------------------------------------------

# Render/Railway PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/plagiarism_db

# -----------------------------------------------------------------------------
# NLP Model Configuration
# -----------------------------------------------------------------------------

# Sentence Transformer for embeddings
# Smaller/faster: sentence-transformers/all-MiniLM-L6-v2 (384 dim)
# Larger/accurate: sentence-transformers/all-mpnet-base-v2 (768 dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# spaCy model for NLP preprocessing
SPACY_MODEL=en_core_web_sm

# -----------------------------------------------------------------------------
# Chunking Configuration
# -----------------------------------------------------------------------------

CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Larger chunks = more context, slower processing
# Smaller chunks = faster, may lose semantic coherence

# -----------------------------------------------------------------------------
# Similarity Search
# -----------------------------------------------------------------------------

# Cosine similarity threshold (0.0 to 1.0)
# Lower = more matches (higher recall, lower precision)
# Higher = fewer matches (lower recall, higher precision)
MIN_SIMILARITY_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------

STORAGE_PATH=./uploads

# Render/Railway: Use persistent disk or configure S3
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Shared Services (from root .env.example)
# -----------------------------------------------------------------------------

JWT_SECRET=your-super-secret-jwt-key-min-32-chars-for-hmac-signing
FRONTEND_URL=http://localhost:3000
