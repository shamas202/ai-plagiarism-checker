# =============================================================================
# BACKEND (Node.js / Express on Render/Railway)
# API Gateway: JWT Auth + Multi-tenant routing + BullMQ queue broker
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

PORT=3001
NODE_ENV=development

# Render/Railway automatically sets PORT env var in production

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Must match root .env.example JWT_SECRET
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-for-hmac-signing
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# Redis (BullMQ Queue Broker)
# -----------------------------------------------------------------------------

# Local development
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Render/Railway Redis Cloud:
# REDIS_HOST=redis-xxxxx.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-password
# REDIS_TLS=true

QUEUE_NAME=document_processing

# -----------------------------------------------------------------------------
# Database (PostgreSQL for metadata)
# -----------------------------------------------------------------------------

# Render/Railway PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/plagiarism_db

# -----------------------------------------------------------------------------
# CORS & Security
# -----------------------------------------------------------------------------

# Local development
FRONTEND_URL=http://localhost:3000

# Production (Vercel frontend)
# FRONTEND_URL=https://your-app.vercel.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------

MAX_FILE_SIZE=10485760
STORAGE_PATH=./uploads

# Render/Railway: Use persistent disk or configure S3
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=info

# Debug in development, warn/error in production
